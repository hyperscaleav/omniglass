{
  "model": "{{ .State | get "configuration" | get "device" | get "model" }}",
  "manufacturer": "{{ .State | get "configuration" | get "device" | get "manufacturer" }}",
  "serial": "{{ .State | get "configuration" | get "device" | get "serial" }}",
  "firmware": "{{ .State | get "configuration" | get "firmware" | get "version" }}",
  "uptime": {{ .State | get "status" | get "device" | get "uptime" }},
  "power": "{{ .State | get "status" | get "device" | get "power" }}"
}
