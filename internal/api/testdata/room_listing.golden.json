{
 "meridian-mx-84": {
  "surface": [
   {
    "name": "http-api",
    "protocol": "http",
    "port": 10080,
    "summary": "Meridian JSON control API",
    "auth_type": "header",
    "fireable": true,
    "routes": [
     {
      "method": "GET",
      "path": "/api/status",
      "summary": "Switcher identity, routed input and the signal on each input"
     },
     {
      "method": "POST",
      "path": "/api/route",
      "summary": "Route an input to the output (hdmi1, hdmi2, hdmi3, dp1)",
      "example": "{\"input\": \"hdmi2\"}\n",
      "sets": [
       {
        "path": "status.switcher.input",
        "field": "input",
        "values": [
         "hdmi1",
         "hdmi2",
         "hdmi3",
         "dp1"
        ],
        "default": "hdmi1"
       }
      ]
     },
     {
      "method": "POST",
      "path": "/api/admin/reboot",
      "summary": "Reboot switcher (clears uptime, routes the first input)",
      "example": "{}"
     }
    ]
   },
   {
    "name": "snmp",
    "protocol": "snmp",
    "port": 10161,
    "summary": "SNMP monitoring",
    "fireable": true,
    "oids": [
     {
      "oid": "1.3.6.1.2.1.1.1.0",
      "path": "configuration.device.model"
     },
     {
      "oid": "1.3.6.1.2.1.1.3.0",
      "path": "status.device.uptime"
     },
     {
      "oid": "1.3.6.1.4.1.55550.1.1.0",
      "path": "status.switcher.input"
     },
     {
      "oid": "1.3.6.1.4.1.55550.1.2.0",
      "path": "status.switcher.signal"
     },
     {
      "oid": "1.3.6.1.4.1.55550.1.10.1.2.1",
      "path": "status.switcher.inputs.hdmi1.signal"
     },
     {
      "oid": "1.3.6.1.4.1.55550.1.10.1.2.2",
      "path": "status.switcher.inputs.hdmi2.signal"
     },
     {
      "oid": "1.3.6.1.4.1.55550.1.10.1.2.3",
      "path": "status.switcher.inputs.hdmi3.signal"
     },
     {
      "oid": "1.3.6.1.4.1.55550.1.10.1.2.4",
      "path": "status.switcher.inputs.dp1.signal"
     },
     {
      "oid": "1.3.6.1.4.1.55550.5.1.0",
      "path": "configuration.firmware.version"
     },
     {
      "oid": "1.3.6.1.4.1.55550.5.2.0",
      "path": "configuration.device.serial"
     }
    ]
   },
   {
    "name": "icmp",
    "protocol": "icmp",
    "port": 0,
    "summary": "ICMP ping reachability",
    "fireable": false
   }
  ],
  "behaviors": [
   {
    "name": "room_meeting",
    "interval": "30s",
    "writes": [
     "status.sim.prev",
     "status.sim.want",
     "status.switcher.input",
     "status.switcher.signal"
    ]
   },
   {
    "name": "signal_follow",
    "interval": "10s",
    "writes": [
     "status.switcher.signal"
    ]
   }
  ]
 },
 "meridian-xl-1": {
