 "newtron-core-3": {
  "surface": [
   {
    "name": "nvp",
    "protocol": "tcp",
    "port": 51325,
    "summary": "NVP line protocol: room control, program state, control ports and connected panels",
    "persistent": true,
    "fireable": true,
    "commands": [
     {
      "match": "GET INPUT"
     },
     {
      "match": "SET INPUT hdmi1"
     },
     {
      "match": "SET INPUT hdmi2"
     },
     {
      "match": "SET INPUT hdmi3"
     },
     {
      "match": "SET INPUT dp1"
     },
     {
      "match": "SET INPUT usbc"
     },
     {
      "match": "SUBSCRIBE INPUT",
      "action": "subscribe"
     },
     {
      "match": "UNSUBSCRIBE INPUT",
      "action": "unsubscribe"
     },
     {
      "match": "SUBSCRIBE LOG",
      "action": "subscribe"
     },
     {
      "match": "GET SCENE"
     },
     {
      "match": "SET SCENE idle"
     },
     {
      "match": "SET SCENE presentation"
     },
     {
      "match": "SET SCENE vc"
     },
     {
      "match": "SUBSCRIBE SCENE",
      "action": "subscribe"
     },
     {
      "match": "GET PROGRAM"
     },
     {
      "match": "SET PROGRAM running"
     },
     {
      "match": "SET PROGRAM stopped"
     },
     {
      "match": "GET PORTS"
     },
     {
      "match": "GET PANELS"
     },
     {
      "match": "GET ROOMPOWER"
     },
     {
      "match": "GET ROOMTEMP"
     },
     {
      "match": "GET MACRO"
     },
     {
      "match": "SUBSCRIBE PROGRAM",
      "action": "subscribe"
     },
     {
      "match": "UNSUBSCRIBE PROGRAM",
      "action": "unsubscribe"
     }
    ]
   },
   {
    "name": "icmp",
    "protocol": "icmp",
    "port": 0,
    "summary": "ICMP ping reachability",
    "fireable": false
   }
  ],
  "behaviors": [
   {
    "name": "room_meeting",
    "interval": "30s",
    "writes": [
     "status.control.macro",
     "status.control.macro_at",
     "status.control.room_power"
    ]
   },
   {
    "name": "room_climate",
    "interval": "30s",
    "writes": [
     "status.room.temperature_c",
     "status.room.climate_c"
    ]
   }
  ]
 },
 "newtron-panel-7": {
  "surface": [
   {
    "name": "http-api",
    "protocol": "http",
    "port": 10443,
    "tls": true,
    "summary": "Newtron HTTP API",
    "auth_type": "form",
    "default_user": "admin",
    "fireable": true,
    "routes": [
     {
      "method": "GET",
      "path": "/",
      "summary": "Touchpanel dashboard"
     },
     {
      "method": "GET",
      "path": "/api/status",
      "summary": "Touchpanel status (panel backlight, occupancy, identity)"
     },
     {
      "method": "POST",
      "path": "/api/room/scene",
      "summary": "Switch room scene (e.g. presentation, vc)",
      "example": "{\"scene\": \"presentation\"}\n"
     },
     {
      "method": "POST",
      "path": "/api/room/source",
      "summary": "Select active room source",
      "example": "{\"source\": \"laptop\"}\n"
     },
     {
      "method": "POST",
      "path": "/api/diagnostics/log",
      "summary": "Write a line to the panel's diagnostics log",
      "example": "{\"line\": \"WARN backlight driver reset\"}\n"
     },
     {
      "method": "POST",
      "path": "/api/panel/brightness",
      "summary": "Set panel backlight brightness (0-100)",
      "example": "{\"brightness\": 85}\n"
     },
     {
      "method": "POST",
      "path": "/api/admin/reboot",
      "summary": "Reboot panel (clears uptime, resets panel state)",
      "example": "{}"
     },
     {
      "method": "POST",
      "path": "/api/admin/factory-reset",
      "summary": "Factory reset (resets every status path to defaults)",
      "example": "{}"
     }
    ]
   },
   {
    "name": "ssh-console",
    "protocol": "ssh",
    "port": 10022,
    "summary": "SSH diagnostic CLI (persistent session)",
    "persistent": true,
    "auth_type": "password",
    "default_user": "admin",
    "fireable": true,
    "commands": [
     {
      "match": "show status",
      "summary": "Panel status overview"
     },
     {
      "match": "show room",
      "summary": "Current room scene and source"
     },
     {
      "match": "reboot",
      "summary": "Reboot panel"
     },
     {
      "match": "factory-reset",
      "summary": "Factory reset panel"
     }
    ]
   },
   {
    "name": "nvp",
    "protocol": "tcp",
    "port": 51325,
    "summary": "NVP line protocol: video input status, selection and events",
    "persistent": true,
    "fireable": true,
    "commands": [
     {
      "match": "GET INPUT"
     },
     {
      "match": "SET INPUT hdmi1"
     },
     {
      "match": "SET INPUT hdmi2"
     },
     {
      "match": "SET INPUT hdmi3"
     },
     {
      "match": "SET INPUT dp1"
     },
     {
      "match": "SET INPUT usbc"
     },
     {
      "match": "SUBSCRIBE INPUT",
      "action": "subscribe"
     },
     {
      "match": "UNSUBSCRIBE INPUT",
      "action": "unsubscribe"
     },
     {
      "match": "SUBSCRIBE LOG",
      "action": "subscribe"
     },
     {
      "match": "GET SCENE"
     },
     {
      "match": "SET SCENE idle"
     },
     {
      "match": "SET SCENE presentation"
     },
     {
      "match": "SET SCENE vc"
     },
     {
      "match": "SUBSCRIBE SCENE",
      "action": "subscribe"
     }
    ]
   },
   {
    "name": "nvp-tls",
    "protocol": "tcp",
    "port": 51326,
    "tls": true,
    "summary": "NVP line protocol over TLS, the panel's own self-signed certificate",
    "persistent": true,
    "fireable": true
   },
   {
    "name": "nvp-telnet",
    "protocol": "telnet",
    "port": 10023,
    "summary": "NVP line protocol over Telnet, behind a login",
    "persistent": true,
    "auth_type": "password",
    "default_user": "admin",
    "fireable": true
   },
   {
    "name": "nvp-udp",
    "protocol": "udp",
    "port": 51327,
    "summary": "NVP line protocol as UDP datagrams, with a seeded share lost",
    "persistent": true,
    "fireable": false
   },
   {
    "name": "snmp",
    "protocol": "snmp",
    "port": 10161,
    "summary": "SNMP monitoring (MIB-2 only, teaching case)",
    "fireable": true,
    "oids": [
     {
      "oid": "1.3.6.1.2.1.1.1.0",
      "path": "configuration.device.model"
     },
     {
      "oid": "1.3.6.1.2.1.1.3.0",
      "path": "status.device.uptime"
     }
    ]
   },
   {
    "name": "icmp",
    "protocol": "icmp",
    "port": 0,
    "summary": "ICMP ping reachability",
    "fireable": false
   }
  ],
  "behaviors": [
   {
    "name": "room_meeting",
    "interval": "30s",
    "writes": [
     "status.panel.awake",
     "status.panel.page"
    ]
   }
  ]
 },
 "newtron-slate-5": {
  "surface": [
   {
    "name": "nvp",
    "protocol": "tcp",
    "port": 51325,
    "summary": "NVP line protocol: the room's booking and its next meeting",
    "persistent": true,
    "fireable": true,
    "commands": [
     {
      "match": "GET BOOKING"
     },
     {
      "match": "BOOK"
     },
     {
      "match": "RELEASE"
     },
     {
      "match": "GET NEXT"
     },
     {
      "match": "GET CURRENT"
     },
     {
      "match": "SUBSCRIBE BOOKING",
      "action": "subscribe"
     },
     {
      "match": "UNSUBSCRIBE BOOKING",
      "action": "unsubscribe"
     }
    ]
   },
   {
    "name": "icmp",
    "protocol": "icmp",
    "port": 0,
    "summary": "ICMP ping reachability",
    "fireable": false
   }
  ],
  "behaviors": [
   {
    "name": "room_bookings",
    "interval": "10s",
    "writes": [
     "status.room.booking",
     "status.room.cal_booking",
     "status.room.current_meeting",
     "status.room.next_meeting"
    ]
   }
  ]
 }
}
