 "polaris-amp-4100": {
  "surface": [
   {
    "name": "http-api",
    "protocol": "http",
    "port": 10080,
    "summary": "Polaris JSON control API",
    "auth_type": "header",
    "fireable": true,
    "routes": [
     {
      "method": "GET",
      "path": "/api/status",
      "summary": "Amplifier status snapshot (power, protect, thermal, channels)"
     },
     {
      "method": "POST",
      "path": "/api/power",
      "summary": "Enter standby or wake (on, standby)",
      "example": "{\"power\": \"standby\"}\n",
      "sets": [
       {
        "path": "status.amp.power",
        "field": "power",
        "values": [
         "on",
         "standby"
        ],
        "default": "on"
       }
      ]
     },
     {
      "method": "POST",
      "path": "/api/protect/reset",
      "summary": "Clear a latched protect state",
      "example": "{}"
     },
     {
      "method": "POST",
      "path": "/api/admin/reboot",
      "summary": "Reboot amplifier (clears uptime and a latched protect)",
      "example": "{}"
     }
    ]
   },
   {
    "name": "snmp",
    "protocol": "snmp",
    "port": 10161,
    "summary": "SNMP monitoring",
    "fireable": true,
    "oids": [
     {
      "oid": "1.3.6.1.2.1.1.1.0",
      "path": "configuration.device.model"
     },
     {
      "oid": "1.3.6.1.2.1.1.3.0",
      "path": "status.device.uptime"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.1.0",
      "path": "status.amp.power"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.2.0",
      "path": "status.amp.protect"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.3.0",
      "path": "status.amp.temperature"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.4.0",
      "path": "status.amp.fan_rpm"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.2.1",
      "path": "status.channels.0.output_db"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.2.2",
      "path": "status.channels.1.output_db"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.2.3",
      "path": "status.channels.2.output_db"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.2.4",
      "path": "status.channels.3.output_db"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.3.1",
      "path": "status.channels.0.clip"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.3.2",
      "path": "status.channels.1.clip"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.3.3",
      "path": "status.channels.2.clip"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.3.4",
      "path": "status.channels.3.clip"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.4.1",
      "path": "status.channels.0.load_ohms"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.4.2",
      "path": "status.channels.1.load_ohms"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.4.3",
      "path": "status.channels.2.load_ohms"
     },
     {
      "oid": "1.3.6.1.4.1.55540.3.10.1.4.4",
      "path": "status.channels.3.load_ohms"
     },
     {
      "oid": "1.3.6.1.4.1.55540.5.1.0",
      "path": "configuration.firmware.version"
     },
     {
      "oid": "1.3.6.1.4.1.55540.5.2.0",
      "path": "configuration.device.serial"
     }
    ]
   },
   {
    "name": "icmp",
    "protocol": "icmp",
    "port": 0,
    "summary": "ICMP ping reachability",
    "fireable": false
   }
  ],
  "behaviors": [
   {
    "name": "temperature_drift",
    "interval": "60s",
    "writes": [
     "status.amp.temperature"
    ]
   },
   {
    "name": "fan_drift",
    "interval": "60s",
    "writes": [
     "status.amp.fan_rpm"
    ]
   },
   {
    "name": "output_drift",
    "interval": "30s",
    "writes": [
     "status.amp.signal_present",
     "status.channels.0.output_db",
     "status.channels.1.output_db",
     "status.channels.2.output_db",
     "status.channels.3.output_db"
    ]
   }
  ]
 },
 "polaris-dsp-16": {
  "surface": [
   {
    "name": "http-api",
    "protocol": "http",
    "port": 10080,
    "summary": "Polaris web and JSON API",
    "auth_type": "header",
    "fireable": true,
    "routes": [
     {
      "method": "GET",
      "path": "/",
      "summary": "DSP dashboard"
     },
     {
      "method": "GET",
      "path": "/api/status",
      "summary": "DSP status snapshot"
     },
     {
      "method": "GET",
      "path": "/api/status.xml",
      "summary": "DSP status snapshot as namespaced XML"
     },
     {
      "method": "GET",
      "path": "/api/channels",
      "summary": "Per-channel state (gain, mute, peak)"
     },
     {
      "method": "POST",
      "path": "/api/channels/mute",
      "summary": "Mute a channel by index",
      "example": "{\"index\": 0, \"mute\": true}\n"
     },
     {
      "method": "POST",
      "path": "/api/channels/gain",
      "summary": "Set channel gain (-60 to +12 dB)",
      "example": "{\"index\": 0, \"gain\": -6}\n"
     },
     {
      "method": "POST",
      "path": "/api/output/mute",
      "summary": "Mute or unmute the program output",
      "example": "{\"mute\": true}\n",
      "sets": [
       {
        "path": "status.output.mute",
        "field": "mute",
        "values": [
         "true",
         "false"
        ],
        "default": "false"
       }
      ]
     },
     {
      "method": "POST",
      "path": "/api/admin/reboot",
      "summary": "Reboot DSP (clears uptime, resets cpu/temp drift)",
      "example": "{}"
     },
     {
      "method": "POST",
      "path": "/api/admin/factory-reset",
      "summary": "Factory reset (resets every DSP status path to defaults)",
      "example": "{}"
     }
    ]
   },
   {
    "name": "ssh-console",
    "protocol": "ssh",
    "port": 10022,
    "summary": "SSH CLI with persistent-session subscriptions",
    "persistent": true,
    "auth_type": "password",
    "default_user": "admin",
    "fireable": true,
    "commands": [
     {
      "match": "show dsp",
      "summary": "DSP health and load"
     },
     {
      "match": "show channels",
      "summary": "Active channel summary"
     },
     {
      "match": "system reboot",
      "summary": "Reboot DSP"
     },
     {
      "match": "system factory-reset",
      "summary": "Factory reset DSP"
     },
     {
      "match": "subscribe channels.0.gain",
      "action": "subscribe"
     },
     {
      "match": "subscribe channels.1.gain",
      "action": "subscribe"
     },
     {
      "match": "subscribe channels.0.mute",
      "action": "subscribe"
     },
     {
      "match": "subscribe dsp.cpu_load",
      "action": "subscribe"
     },
     {
      "match": "subscribe dsp.temperature",
      "action": "subscribe"
     },
     {
      "match": "subscribe dsp.cpu_load 1000",
      "action": "subscribe"
     },
     {
      "match": "subscribe dsp.temperature 2000",
      "action": "subscribe"
     },
     {
      "match": "unsubscribe channels.0.gain",
      "action": "unsubscribe"
     },
     {
      "match": "unsubscribe channels.0.mute",
      "action": "unsubscribe"
     },
     {
      "match": "unsubscribe dsp.cpu_load",
      "action": "unsubscribe"
     },
     {
      "match": "unsubscribe dsp.temperature",
      "action": "unsubscribe"
     }
    ]
   },
   {
    "name": "telnet-console",
    "protocol": "telnet",
    "port": 10023,
    "summary": "Telnet CLI with persistent-session subscriptions",
    "persistent": true,
    "auth_type": "password",
    "default_user": "admin",
    "fireable": true,
    "commands": [
     {
      "match": "show dsp"
     },
     {
      "match": "show channels"
     },
     {
      "match": "system reboot"
     },
     {
      "match": "system factory-reset"
     },
     {
      "match": "subscribe channels.0.gain",
      "action": "subscribe"
     },
     {
      "match": "subscribe channels.0.mute",
      "action": "subscribe"
     },
     {
      "match": "subscribe dsp.cpu_load",
      "action": "subscribe"
     },
     {
      "match": "subscribe dsp.cpu_load 1000",
      "action": "subscribe"
     },
     {
      "match": "unsubscribe channels.0.gain",
      "action": "unsubscribe"
     },
     {
      "match": "unsubscribe channels.0.mute",
      "action": "unsubscribe"
     },
     {
      "match": "unsubscribe dsp.cpu_load",
      "action": "unsubscribe"
     }
    ]
   },
   {
    "name": "qrc",
    "protocol": "tcp",
    "port": 1710,
    "summary": "JSON-RPC control over raw TCP (NUL-terminated)",
    "persistent": true,
    "fireable": true,
    "commands": [
     {
      "match": "{\"jsonrpc\":\"2.0\",\"method\":\"NoOp\",\"id\":0}",
      "summary": "Heartbeat"
     },
     {
      "match": "{\"jsonrpc\":\"2.0\",\"method\":\"EngineStatus\",\"id\":1}"
     },
     {
      "match": "{\"jsonrpc\":\"2.0\",\"method\":\"Component.Get\",\"params\":{\"Name\":\"Mixer1\",\"Controls\":[{\"Name\":\"gain\"}]},\"id\":2}"
     },
     {
      "match": "{\"jsonrpc\":\"2.0\",\"method\":\"ChangeGroup.AddControl\",\"params\":{\"Id\":\"sub1\",\"Controls\":[\"Mixer1.gain\"]},\"id\":3}",
      "action": "subscribe"
     },
     {
      "match": "{\"jsonrpc\":\"2.0\",\"method\":\"ChangeGroup.Remove\",\"params\":{\"Id\":\"sub1\"},\"id\":4}",
      "action": "unsubscribe"
     }
    ]
   },
   {
    "name": "snmp",
    "protocol": "snmp",
    "port": 10161,
    "summary": "SNMP monitoring",
    "fireable": true,
    "oids": [
     {
      "oid": "1.3.6.1.2.1.1.1.0",
      "path": "configuration.device.model"
     },
     {
      "oid": "1.3.6.1.2.1.1.3.0",
      "path": "status.device.uptime"
     },
     {
      "oid": "1.3.6.1.2.1.1.5.0",
      "path": "configuration.network.hostname"
     },
     {
      "oid": "1.3.6.1.4.1.55540.2.1.0",
      "path": "status.dsp.cpu_load"
     },
     {
      "oid": "1.3.6.1.4.1.55540.2.2.0",
      "path": "status.dsp.active_channels"
     },
     {
      "oid": "1.3.6.1.4.1.55540.2.3.0",
      "path": "status.dsp.temperature"
     },
     {
      "oid": "1.3.6.1.4.1.55540.2.4.0",
      "path": "status.dsp.fan_rpm"
     },
     {
      "oid": "1.3.6.1.4.1.55540.2.5.0",
      "path": "status.output.mute"
     },
     {
      "oid": "1.3.6.1.4.1.55540.2.6.0",
      "path": "status.output.level_db"
     },
     {
      "oid": "1.3.6.1.4.1.55540.5.1.0",
      "path": "configuration.firmware.version"
     },
     {
      "oid": "1.3.6.1.4.1.55540.5.2.0",
      "path": "configuration.device.serial"
     },
     {
      "oid": "1.3.6.1.4.1.55540.5.3.0",
      "path": "configuration.device.hardware_revision"
     },
     {
      "oid": "1.3.6.1.4.1.55540.5.4.0",
      "path": "status.network.ipv4.address"
     },
     {
      "oid": "1.3.6.1.4.1.55540.5.5.0",
      "path": "status.network.ipv4.mac"
     }
    ]
   },
   {
    "name": "udp-echo",
    "protocol": "udp",
    "port": 9000,
    "summary": "UDP echo responder for custom protocol probing",
    "fireable": false
   },
   {
    "name": "icmp",
    "protocol": "icmp",
    "port": 0,
    "summary": "ICMP ping reachability",
    "fireable": false
   }
  ],
  "behaviors": [
   {
    "name": "cpu_drift",
    "interval": "30s",
    "writes": [
     "status.dsp.cpu_load"
    ]
   },
   {
    "name": "temperature_drift",
    "interval": "60s",
    "writes": [
     "status.dsp.temperature"
    ]
   },
   {
    "name": "output_level_drift",
    "interval": "15s",
    "writes": [
     "status.output.level_db"
    ]
   },
   {
    "name": "room_signal",
    "interval": "15s",
    "writes": [
     "status.dsp.active_channels",
     "status.channels.0.gate",
     "status.channels.0.peak_db",
     "status.channels.1.gate",
     "status.channels.1.peak_db",
     "status.channels.2.gate",
     "status.channels.2.peak_db",
     "status.channels.3.gate",
     "status.channels.3.peak_db"
    ]
   }
  ]
 }
}
