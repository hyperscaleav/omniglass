{
 "lyra-arc-a2": {
  "surface": [
   {
    "name": "http-api",
    "protocol": "http",
    "port": 10080,
    "summary": "Lyra control API",
    "auth_type": "header",
    "fireable": true,
    "routes": [
     {
      "method": "GET",
      "path": "/api/status",
      "summary": "Microphone identity and state"
     },
     {
      "method": "POST",
      "path": "/api/mute",
      "summary": "Mute or unmute the microphone",
      "example": "{\"mute\": true}\n",
      "sets": [
       {
        "path": "status.mic.mute",
        "field": "mute",
        "values": [
         "true",
         "false"
        ],
        "default": "false"
       }
      ]
     }
    ]
   },
   {
    "name": "snmp",
    "protocol": "snmp",
    "port": 10161,
    "summary": "SNMP monitoring",
    "fireable": true,
    "oids": [
     {
      "oid": "1.3.6.1.2.1.1.1.0",
      "path": "configuration.device.model"
     },
     {
      "oid": "1.3.6.1.2.1.1.3.0",
      "path": "status.device.uptime"
     },
     {
      "oid": "1.3.6.1.4.1.55530.1.1.0",
      "path": "status.mic.mute"
     },
     {
      "oid": "1.3.6.1.4.1.55530.1.2.0",
      "path": "status.mic.level_db"
     },
     {
      "oid": "1.3.6.1.4.1.55530.5.1.0",
      "path": "configuration.firmware.version"
     },
     {
      "oid": "1.3.6.1.4.1.55530.5.2.0",
      "path": "configuration.device.serial"
     }
    ]
   },
   {
    "name": "icmp",
    "protocol": "icmp",
    "port": 0,
    "summary": "ICMP ping reachability",
    "fireable": false
   }
  ],
  "behaviors": [
   {
    "name": "call_state",
    "interval": "15s",
    "writes": [
     "status.mic.active",
     "status.mic.mute"
    ]
   },
   {
    "name": "level_drift",
    "interval": "15s",
    "writes": [
     "status.mic.level_db"
    ]
   }
  ]
 },
