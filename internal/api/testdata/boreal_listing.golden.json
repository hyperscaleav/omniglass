     },
     {
      "method": "POST",
      "path": "/api/admin/reboot",
      "summary": "Reboot display (clears uptime, resets display state)",
      "example": "{}"
     },
     {
      "method": "POST",
      "path": "/api/admin/factory-reset",
      "summary": "Factory reset (resets every status path to defaults)",
      "example": "{}"
     }
    ]
   },
   {
    "name": "snmp",
    "protocol": "snmp",
    "port": 10161,
    "summary": "SNMP monitoring",
    "fireable": true,
    "oids": [
     {
      "oid": "1.3.6.1.2.1.1.1.0",
      "path": "configuration.device.model"
     },
     {
      "oid": "1.3.6.1.2.1.1.3.0",
      "path": "status.device.uptime"
     },
     {
      "oid": "1.3.6.1.4.1.55520.1.1.1.0",
      "path": "status.device.power"
     },
     {
      "oid": "1.3.6.1.4.1.55520.2.2.0",
      "path": "status.display.input"
     },
     {
      "oid": "1.3.6.1.4.1.55520.2.3.0",
      "path": "status.display.brightness"
     },
     {
      "oid": "1.3.6.1.4.1.55520.2.4.0",
      "path": "status.display.temperature"
     },
     {
      "oid": "1.3.6.1.4.1.55520.3.1.0",
      "path": "status.audio.volume"
     },
     {
      "oid": "1.3.6.1.4.1.55520.3.2.0",
      "path": "status.audio.mute"
     },
     {
      "oid": "1.3.6.1.4.1.55520.4.1.0",
      "path": "status.network.ipv4.address"
     },
     {
      "oid": "1.3.6.1.4.1.55520.4.2.0",
      "path": "status.network.ipv4.mac"
     },
     {
      "oid": "1.3.6.1.4.1.55520.5.2.0",
      "path": "configuration.device.serial"
     }
    ]
   },
   {
    "name": "icmp",
    "protocol": "icmp",
    "port": 0,
    "summary": "ICMP ping reachability",
    "fireable": false
   }
  ],
  "behaviors": [
   {
    "name": "room_meeting",
    "interval": "30s",
    "writes": [
     "status.sim.busy",
     "status.sim.known",
     "status.sim.until",
     "status.device.power",
     "status.display.input",
     "status.sim.awake"
    ]
   },
   {
    "name": "temperature_drift",
    "interval": "60s",
    "writes": [
     "status.display.temperature"
    ]
   }
  ]
 }
}
