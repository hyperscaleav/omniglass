{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "e2e/walkthroughlib.mjs", "e2e/walkthroughpr.mjs", "e2e/walkthroughcore.mjs", "../docs/src/plugins/walkthrough-embed.mjs", "../docs/scripts/lib/embed-scan.mjs"]
}
