# Copy to .env (gitignored) and fill in what you need. Nothing loads it on its
# own; export it into a shell first:
#   set -a; . ./.env; set +a

# The live model test, TestOpenAILive (internal/assistant/provider). It skips
# while the key is empty. Base URL and model default to the install's
# (OpenRouter) when unset; these values point it at Bedrock's gpt-oss, which
# takes a Bedrock API key.
OMNIGLASS_TEST_MODEL_KEY=
OMNIGLASS_TEST_MODEL_BASE_URL=https://bedrock-runtime.us-west-2.amazonaws.com/openai/v1
OMNIGLASS_TEST_MODEL_NAME=openai.gpt-oss-20b-1:0

# Server settings by environment (#2223). Any one key the server would show in
# Admin > Settings may be set from the server's environment, as
# OMNIGLASS_SETTING__<NAMESPACE>__<KEY>=value (double underscore between the
# parts). The env level sits between the committed settings file and the
# console binding, so an admin's edit still wins; a profile-domain namespace
# (ui, keybindings) is refused at boot. `omniglass lab run` forwards every
# OMNIGLASS_SETTING__ variable in its shell to the lab's server, and refuses to
# start, naming the variable, on one the server would refuse.
#
# A lab with omnibot on Bedrock: these two, plus the key above, then
#   omniglass lab run --omnibot-key-env OMNIGLASS_TEST_MODEL_KEY
# The flag stores the key as the lab's model key and sets the provider; these
# point it at Bedrock's gpt-oss. Comment them out to go back to OpenRouter.
OMNIGLASS_SETTING__ASSISTANT__BASE_URL=https://bedrock-runtime.us-west-2.amazonaws.com/openai/v1
OMNIGLASS_SETTING__ASSISTANT__MODEL=openai.gpt-oss-20b-1:0
#
# Other examples:
#   OMNIGLASS_SETTING__RETENTION__METRIC_DAYS=30
#   OMNIGLASS_SETTING__LABEL__ACRONYMS=AV,DSP,HDMI,PoE,UC
#
# The full list of settable keys is the generated env-var reference
# (docs/src/generated/config.json; the Container image guide's Configuration
# section).
