{{- $rooms := .State | get "status" | get "rooms" -}}
{{- $p := pageKeys $rooms .Request.Query.next_page_token .Request.Query.page_size -}}
{
  "rooms": [
  {{- $sep := "" }}
  {{- range $id := $p.keys }}{{ $r := index $rooms $id }}{{ $sep }}
    {{/* @field status.rooms.*.state string "booked while a booked meeting holds the room, else free" */}}
    {"id": {{ marshal $id }}, "state": {{ marshal (or (index $r "state") "free") }}, "today": {{ or (index $r "today") 0 }}, "remaining": {{ or (index $r "remaining") 0 }}, "current": {{ marshal (or (index $r "current") "") }}, "next_start": {{ or (index $r "next_start") 0 }}}
  {{- $sep = "," }}
  {{- end }}
  ],
  "page_size": {{ len $p.keys }},
  "next_page_token": {{ marshal $p.next }}
}
