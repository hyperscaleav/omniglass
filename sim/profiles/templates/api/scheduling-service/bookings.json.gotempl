{
  {{/* @field status.bookings.today number "Booked meetings today across the rooms the platform serves" */}}
  "today": {{ .State | get "status" | get "bookings" | get "today" }},
  {{/* @field status.bookings.remaining number "Booked meetings still to come today, the one running included" */}}
  "remaining": {{ .State | get "status" | get "bookings" | get "remaining" }},
  {{/* @field status.bookings.in_progress number "Rooms a booked meeting holds now" */}}
  "in_progress": {{ .State | get "status" | get "bookings" | get "in_progress" }},
  {{/* @field configuration.rooms_served number "Rooms the platform speaks for" */}}
  "rooms_served": {{ .State | get "configuration" | get "rooms_served" }},
  {{/* @field configuration.sync_ok bool "Whether the last config sync succeeded" */}}
  "sync_ok": {{ .State | get "configuration" | get "sync_ok" }}
}
