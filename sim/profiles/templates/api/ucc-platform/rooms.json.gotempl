{{- /* Token paging, as a cloud room API pages: page_size caps the page, the
   answer's next_page_token names the first room of the next page and is sent
   back as next_page_token, empty on the last page. No page_size answers every room. */ -}}
{{- $size := atoi (index .Request.Query "page_size") }}
{{- $from := index .Request.Query "next_page_token" }}
{{- $n := 0 }}{{ $next := "" }}{{ $sep := "" }}
{
  "rooms": [
  {{- range $id, $r := (.State | get "status" | get "rooms") }}
  {{- if lt $id $from }}{{ else if and $size (ge $n $size) }}{{ if eq $next "" }}{{ $next = $id }}{{ end }}{{ else }}{{ $sep }}
    {{/* @field status.rooms.*.state string "idle or in-call" */}}
    {"id": {{ marshal $id }}, "name": {{ marshal (or (index $r "name") $id) }}, "state": {{ marshal (or (index $r "state") "idle") }}, "meeting": {{ marshal (or (index $r "meeting") "") }}, "participants": {{ or (index $r "participants") 0 }}}
  {{- $sep = "," }}{{ $n = add $n 1 }}
  {{- end }}
  {{- end }}
  ],
  "next_page_token": {{ marshal $next }}
}
