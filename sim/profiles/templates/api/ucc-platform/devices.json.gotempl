{{- /* The account's devices, token-paged like its rooms: the devices of the rooms
   the world covers and the ones the platform holds that no room places, in id
   order. next_page_token names the last device of the page, empty on the last. */ -}}
{{- $p := devicePage (.State | get "status" | get "devices") .Request.Query.next_page_token .Request.Query.page_size -}}
{
  "devices": [
  {{- $sep := "" }}
  {{- range $d := $p.devices }}{{ $sep }}
    {{/* @field status.devices.*.status string "online or offline" */}}
    {"id": {{ marshal $d.id }}, "name": {{ marshal $d.name }}, "room_id": {{ marshal $d.room_id }}, "type": {{ marshal $d.type }}, "status": {{ marshal $d.status }}, "firmware": {{ marshal $d.firmware }}, "last_seen": {{ $d.last_seen }}}
  {{- $sep = "," }}
  {{- end }}
  ],
  "page_size": {{ len $p.devices }},
  "next_page_token": {{ marshal $p.next }}
}
