{
  "device": {
    "power": "{{ .State | get "status" | get "device" | get "power" }}",
    "uptime": {{ .State | get "status" | get "device" | get "uptime" }},
    "model": "{{ .State | get "configuration" | get "device" | get "model" }}",
    "serial": "{{ .State | get "configuration" | get "device" | get "serial" }}",
    "firmware": "{{ .State | get "configuration" | get "firmware" | get "version" }}",
    {{/* @field status.device.cpu_load number "Codec CPU load, percent" */}}
    "cpu_load": {{ .State | get "status" | get "device" | get "cpu_load" }},
    {{/* @field status.device.temperature number "Codec temperature, degrees Celsius" */}}
    "temperature": {{ .State | get "status" | get "device" | get "temperature" }},
    {{/* @field status.device.fan_rpm number "Cooling fan speed, rpm" */}}
    "fan_rpm": {{ .State | get "status" | get "device" | get "fan_rpm" }},
    {{/* @field status.device.memory_used number "Memory in use, a fraction (0 to 1)" */}}
    "memory_used": {{ .State | get "status" | get "device" | get "memory_used" }}
  },
  "app": {
    "mode": "{{ .State | get "status" | get "app" | get "mode" }}",
    "ucc_signin": "{{ .State | get "status" | get "app" | get "ucc_signin" }}",
    "touch_pair": "{{ .State | get "status" | get "peripherals" | get "touch_pair" }}",
    "local_presentation": {{ .State | get "status" | get "presentation" | get "local_active" }}
  },
  "call": {
    "active": {{ .State | get "status" | get "call" | get "active" }},
    "participants": {{ .State | get "status" | get "call" | get "participants" }}
  },
  "audio": {
    "volume": {{ .State | get "status" | get "audio" | get "volume" }},
    "mic_mute": {{ .State | get "status" | get "audio" | get "mic_mute" }},
    "speaker_level": {{ .State | get "status" | get "audio" | get "speaker_level" }},
    {{/* @field status.audio.mic_level_db number "Microphone array input level, dBFS" */}}
    "mic_level_db": {{ .State | get "status" | get "audio" | get "mic_level_db" }}
  },
  "video": {
    "camera_on": {{ .State | get "status" | get "video" | get "camera_on" }},
    "resolution": "{{ .State | get "status" | get "video" | get "resolution" }}",
    {{/* @field status.video.people_count number "People the camera counts in the room" */}}
    "people_count": {{ .State | get "status" | get "video" | get "people_count" }}
  },
  "media": {
    {{/* @field status.media.packet_loss number "Packet loss of the call's media, a ratio (0 to 1); 0 when idle" */}}
    "packet_loss": {{ .State | get "status" | get "media" | get "packet_loss" }},
    {{/* @field status.media.jitter_ms number "Jitter of the call's media, ms; 0 when idle" */}}
    "jitter_ms": {{ .State | get "status" | get "media" | get "jitter_ms" }},
    {{/* @field status.media.bitrate_kbps number "Send bitrate of the call's video, kbps; 0 when idle" */}}
    "bitrate_kbps": {{ .State | get "status" | get "media" | get "bitrate_kbps" }},
    {{/* @field status.media.frame_rate number "Frame rate of the call's video, fps; 0 when idle" */}}
    "frame_rate": {{ .State | get "status" | get "media" | get "frame_rate" }}
  }
}
