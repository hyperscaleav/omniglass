---
// Live implementation-status grid: sourced from each page's status badge (the
// single source of truth), so it never drifts from the badges. The rebuilt
// pages carry the badges, in whatever section they land (ADR-2087.2); a page
// with no badge is not a row.
import { getCollection } from 'astro:content';
import { Badge } from '@astrojs/starlight/components';

const rows = (await getCollection('docs'))
  .map((e) => {
    const raw = e.data.sidebar?.badge;
    const badge = raw
      ? typeof raw === 'string'
        ? { text: raw, variant: 'default' }
        : raw
      : null;
    return { title: e.data.title, id: e.id, badge };
  })
  .filter((r) => r.badge)
  .sort((a, b) => a.title.localeCompare(b.title));
---

{rows.length === 0 ? (
  <p>No rebuilt page carries a badge yet. The first rows land with the rebuilt sections.</p>
) : (
  <table>
    <thead>
      <tr><th>Capability</th><th>Status</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td><a href={`/${r.id}/`}>{r.title}</a></td>
          <td><Badge text={r.badge.text} variant={r.badge.variant} /></td>
        </tr>
      ))}
    </tbody>
  </table>
)}
