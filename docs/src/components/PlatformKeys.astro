---
// The platform class's metric keys rendered from the code (#1625): the keys
// docs/src/generated/writerclass.json says the platform class holds, joined to
// their seeded metric types in docs/src/generated/seed.json (both written by
// make gen). A key joins the platform map and the seed, and this table, in the
// one change, so the self-monitoring sections cannot list a key the gateway
// does not reserve or miss one it does.
import facts from '../generated/writerclass.json';
import seed from '../generated/seed.json';

const platform = facts.find((c) => c.class === 'platform');
if (!platform) {
  throw new Error('PlatformKeys: writerclass.json has no platform class');
}
const reserved = new Set(platform.keys);
const rows = seed.metric_types.filter((m) => reserved.has(m.name));
if (rows.length === 0) {
  throw new Error('PlatformKeys: the seed ships no platform metric type');
}
---

<table class="seeded-set">
  <thead><tr><th>Key</th><th>Type</th><th>Unit</th><th>What it reads</th></tr></thead>
  <tbody>
    {rows.map((m) => (
      <tr>
        <td><code>{m.name}</code></td>
        <td>{m.data_type}</td>
        <td>{m.unit ?? ''}</td>
        <td>{m.description}</td>
      </tr>
    ))}
  </tbody>
</table>
