---
// One shipped-set claim rendered from the generated seed facts
// (docs/src/generated/seed.json, written by make gen via cmd/seedgen). The
// guides used to enumerate these sets in prose and undercount them (the audit
// found two of eleven property types missing); this component renders the set
// the binary actually seeds, so the claim cannot drift.
//
// Usage: <SeededSet kind="property_types" />, kind one of the seed.json keys.
// The template catalog (ADR-0827) is one key, `templates`, narrowed to one
// template kind with `of`: <SeededSet kind="templates" of="standard_template" />.
import seed from '../generated/seed.json';

interface Props {
  kind: string;
  of?: string;
}

const { kind, of } = Astro.props;
const all = seed[kind];
if (!all) {
  throw new Error(`SeededSet: unknown kind "${kind}" (not a key of docs/src/generated/seed.json)`);
}
const rows = kind === 'templates' && of ? all.filter((t) => t.kind === of) : all;
if (kind === 'templates' && of && rows.length === 0) {
  throw new Error(`SeededSet: the catalog ships no "${of}" templates`);
}
// A place template's subtree, flattened depth-first for its row.
function placeLines(p, depth = 0) {
  const here = `${'  '.repeat(depth)}${p.type}${p.name ? ` ${p.name}` : ''}${(p.systems ?? []).length ? `: ${p.systems.map((s) => s.template).join(', ')}` : ''}`;
  return [here, ...(p.places ?? []).flatMap((c) => placeLines(c, depth + 1))];
}

// The inheriting registries (component_type, system_type) are nested by
// parent_id, so they are laid out depth-first from the roots in declaration
// order rather than printed flat. Depth is climbed rather than assumed from
// adjacency: a subtype declared away from its parent still lands under it.
const nested = kind === 'component_types' || kind === 'system_types';
const childrenOf = new Map();
if (nested) {
  for (const r of rows) {
    const key = r.parent_id ?? '';
    childrenOf.set(key, [...(childrenOf.get(key) ?? []), r]);
  }
}
function walk(parent = '', depth = 0) {
  return (childrenOf.get(parent) ?? []).flatMap((r) => [{ ...r, depth }, ...walk(r.id, depth + 1)]);
}
const tree = nested ? walk() : [];
// Only component_type carries default_tags, and no shipped row uses one today.
// The column appears the moment a seeded row does, rather than standing empty
// on twenty rows or being remembered by whoever adds the first tag.
const anyTags = tree.some((t) => t.default_tags?.length);
if (nested && tree.length !== rows.length) {
  throw new Error(`SeededSet: ${kind} has ${rows.length} rows but ${tree.length} reachable from a root (an orphan parent_id?)`);
}
---

{
  kind === 'roles' ? (
    <div class="seeded-set">
      {rows.map((r) => (
        <details>
          <summary>
            <strong>{r.label}</strong> (<code>{r.id}</code>
            {r.inherits?.length ? <> inherits {r.inherits.join(', ')}</> : null}): {r.description}
          </summary>
          <p>Effective permissions ({r.effective.length}):</p>
          <ul>{r.effective.map((p) => <li><code>{p}</code></li>)}</ul>
        </details>
      ))}
    </div>
  ) : kind === 'severity_levels' ? (
    <table class="seeded-set">
      <thead><tr><th>Level</th><th>Color</th><th>Rank</th><th>An active alarm at it</th></tr></thead>
      <tbody>
        {rows.map((l) => (
          <tr>
            <td><code>{l.name}</code> ({l.label})</td>
            <td>{l.color}</td>
            <td>{l.rank}</td>
            <td>{l.outage ? 'puts its component in outage' : 'degrades its component'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : kind === 'event_rules' ? (
    <table class="seeded-set">
      <thead><tr><th>Rule</th><th>Reads</th><th>Fires</th><th>Clears</th><th>Writes</th><th>Severity</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td><code>{r.name}</code> ({r.label})</td>
            <td><code>{r.sample_key}</code></td>
            <td><code>{r.fire}</code>{r.fire_sustain ? ` for ${r.fire_sustain}` : ''}</td>
            <td>{r.clear ? <code>{r.clear}</code> : 'the opposite'}{r.clear_sustain ? ` after ${r.clear_sustain}` : ''}</td>
            <td><code>{r.fire_event_type}</code>{r.clear_event_type ? <>, <code>{r.clear_event_type}</code></> : ''}</td>
            <td>{r.severity ? <code>{r.severity}</code> : 'none (informational)'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : kind === 'notification_types' ? (
    <table class="seeded-set">
      <thead><tr><th>Type</th><th>Subject</th><th>Text</th></tr></thead>
      <tbody>
        {rows.map((t) => (
          <tr>
            <td><code>{t.name}</code> ({t.label})</td>
            <td><code>{t.subject}</code></td>
            <td><pre>{t.text}</pre></td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : kind === 'secret_types' ? (
    <table class="seeded-set">
      <thead><tr><th>Type</th><th>Fields</th><th>Admin-sensitive default</th></tr></thead>
      <tbody>
        {rows.map((s) => (
          <tr>
            <td><code>{s.id}</code> ({s.label})</td>
            <td>{s.fields.map((f) => (<span><code>{f.name}</code>{f.secret ? ' (secret)' : ''} </span>))}</td>
            <td>{s.default_admin_sensitive ? 'yes' : 'no'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : kind === 'templates' && of === 'standard_template' ? (
    <table class="seeded-set">
      <thead><tr><th>Template</th><th>Variant of</th><th>Roles a fork declares</th></tr></thead>
      <tbody>
        {rows.map((t) => (
          <tr>
            <td><code>{t.name}</code> ({t.label})</td>
            <td>{t.standard.parent ? <code>{t.standard.parent}</code> : ''}</td>
            <td>
              {t.standard.roles.map((r) => (
                <span><code>{r.name}</code> (quorum {r.quorum || 1}{r.accepted_types?.length ? `, accepts ${r.accepted_types.join(' + ')}` : ''}{r.pinned_products?.length ? `, pins ${r.pinned_products.join(' + ')}` : ''}) </span>
              ))}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : kind === 'templates' ? (
    <table class="seeded-set">
      <thead><tr><th>Template</th><th>Kind</th><th>What it creates</th></tr></thead>
      <tbody>
        {rows.map((t) => (
          <tr>
            <td><code>{t.name}</code> ({t.label})</td>
            <td><code>{t.kind}</code></td>
            <td>
              {t.standard ? <>a standard{t.standard.parent ? <>, a variant of <code>{t.standard.parent}</code></> : ''}, with {t.standard.roles.length} roles</> : null}
              {t.component ? <>a <code>{t.component.product}</code> component{Object.keys(t.component.attach?.inputs ?? {}).length ? <>, its driver preset with {Object.keys(t.component.attach.inputs).map((k) => <code>{k} </code>)}</> : ''}</> : null}
              {t.system ? <>a system on <code>{t.system.standard}</code>, filling {Object.entries(t.system.roles).map(([role, f]) => <span><code>{role}</code> with <code>{f.component ?? f.product}</code> </span>)}</> : null}
              {t.place ? <pre>{placeLines(t.place).join('\n')}</pre> : null}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : kind === 'vendors' ? (
    <table class="seeded-set">
      <thead><tr><th>Vendor</th><th>Kind</th><th>Website</th></tr></thead>
      <tbody>
        {rows.map((v) => (
          <tr>
            <td><code>{v.id}</code> ({v.label})</td>
            <td>{v.kind}</td>
            <td>{v.website ? <code>{v.website}</code> : ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : kind === 'products' ? (
    <table class="seeded-set">
      <thead><tr><th>Product</th><th>Vendor</th><th>Driver</th><th>Kind</th><th>Declared properties</th></tr></thead>
      <tbody>
        {rows.map((p) => (
          <tr>
            <td><code>{p.id}</code> ({p.label})</td>
            <td>{p.vendor_id ? <code>{p.vendor_id}</code> : ''}</td>
            <td>{p.driver_id ? <code>{p.driver_id}</code> : ''}</td>
            <td>{p.kind}</td>
            <td>{(p.properties ?? []).map((d) => (<span><code>{d.name}</code>{d.default ? ` = ${d.default}` : ''} </span>))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : kind === 'location_types' ? (
    <table class="seeded-set">
      <thead><tr><th>Type</th><th>Allowed parents</th><th>Names</th></tr></thead>
      <tbody>
        {rows.map((lt) => (
          <tr>
            <td><code>{lt.id}</code> ({lt.label})</td>
            <td>{lt.allowed_parent_types?.length ? lt.allowed_parent_types.join(', ') : '(top level)'}</td>
            <td>{!lt.name_rule
              ? 'you name it'
              : !lt.name_rule.stem
                ? '1, 2, 3'
                : lt.name_rule.bare_first
                  ? `${lt.name_rule.stem}, ${lt.name_rule.stem}-2`
                  : `${lt.name_rule.stem}-1, ${lt.name_rule.stem}-2`}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : nested ? (
    <table class="seeded-set">
      <thead><tr><th>Type</th><th>Stem</th><th>Abbrev</th><th>Icon</th>{anyTags ? <th>Default tags</th> : null}</tr></thead>
      <tbody>
        {tree.map((t) => (
          <tr>
            <td style={`padding-left: ${0.5 + t.depth * 1.25}rem`}>
              <code>{t.id}</code> ({t.label})
            </td>
            <td>{t.stem ? <code>{t.stem}</code> : <em>inherits</em>}</td>
            <td>{t.abbrev ? <code>{t.abbrev}</code> : <em>inherits</em>}</td>
            <td>{t.icon ? <code>{t.icon}</code> : <em>inherits</em>}</td>
            {anyTags ? <td>{(t.default_tags ?? []).map((g) => <span><code>{g}</code> </span>)}</td> : null}
          </tr>
        ))}
      </tbody>
    </table>
  ) : kind === 'drivers' ? (
    <table class="seeded-set">
      <thead><tr><th>Name</th><th>Version</th><th>Rides</th><th>Menu</th></tr></thead>
      <tbody>
        {rows.map((d) => (
          <tr>
            <td><code>{d.id}</code></td>
            <td>{d.version ?? ''}</td>
            <td>{d.transport ? <code>{d.transport}</code> : ''}</td>
            <td>{d.transport
              ? [d.polls ? `${d.polls} poll${d.polls === 1 ? '' : 's'}` : '',
                 d.listeners ? `${d.listeners} listener${d.listeners === 1 ? '' : 's'}` : '',
                 d.commands ? `${d.commands} command${d.commands === 1 ? '' : 's'}` : '']
                  .filter(Boolean).join(', ')
              : 'stub, no spec yet'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : kind === 'property_types' ? (
    <table class="seeded-set">
      <thead><tr><th>Name</th><th>Kind</th><th>Type</th><th>Unit</th><th>Description</th></tr></thead>
      <tbody>
        {rows.map((p) => (
          <tr>
            <td><code>{p.name}</code></td>
            <td>{p.kind ?? ''}</td>
            <td>{p.data_type}</td>
            <td>{p.unit ?? ''}</td>
            <td>{p.description ?? p.label}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <table class="seeded-set">
      <thead><tr><th>Name</th><th>Description</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td><code>{r.name ?? r.id}</code>{r.built === false ? ' (declared, not built)' : ''}</td>
            <td>{r.description ?? r.label ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )
}
