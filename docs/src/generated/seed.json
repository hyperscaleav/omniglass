 "property_types": [
  {
   "name": "endpoint-reachable",
   "data_type": "string",
   "label": "Endpoint Reachable",
   "description": "Per-endpoint reachability verdict, the AND of the endpoint's probe results (up = every applicable probe reached the target). A built-in state: availability is time_in_state over it. Unknown/stale are read-time derivations, not stored values."
  },
  {
   "name": "health",
   "data_type": "string",
   "label": "Health",
   "description": "The rolled-up health verdict for a component, system, or location, worst-wins over its inputs (a component's active alarms, a system's roles, the systems under a location). Recorded transition-only, so the series is the edges: when it broke and when it came back, not a sample per check. incomplete ranks between healthy and degraded and means a commissioning gap: a role short because its hardware was never installed, which no alarm will ever fire for."
  },
  {
   "name": "video-input",
   "data_type": "string",
   "label": "Video Input",
   "description": "The selected video input on a display or switcher. A settable state: the set-input command tells the device which input to select (opening an intended value), and the device reports the observed input, so the two reconcile."
  },
  {
   "name": "serial-number",
   "data_type": "string",
   "label": "Serial number",
   "description": "The manufacturer serial number of the device."
  },
  {
   "name": "mac-address",
   "data_type": "string",
   "label": "MAC address",
   "description": "The primary hardware (MAC) address, lowercase colon-separated."
  },
  {
   "name": "firmware-version",
   "data_type": "string",
   "label": "Firmware version",
   "description": "The installed firmware or software version."
  },
  {
   "name": "model-number",
   "data_type": "string",
   "label": "Model number",
   "description": "The manufacturer model number."
  }
 ],
 "metric_types": [
  {
   "name": "icmp-reachable",
   "data_type": "int",
   "label": "ICMP Reachable",
   "description": "ICMP inline probe result (1 = at least one echo returned, 0 = none)."
  },
  {
   "name": "icmp-rtt-avg",
   "data_type": "float",
   "unit": "ms",
   "label": "ICMP RTT (avg)",
   "description": "Average round-trip time over the task's echoes; absent when unreachable."
  },
  {
   "name": "tcp-open",
   "data_type": "int",
   "label": "TCP Port Open",
   "description": "TCP-connect probe result (1 = the port accepted a connection, 0 = refused/timeout)."
  },
  {
   "name": "tcp-connect-time",
   "data_type": "float",
   "unit": "ms",
   "label": "TCP Connect Time",
   "description": "Time to establish the TCP connection; absent when the port is closed."
  },
  {
   "name": "room-temperature",
   "data_type": "float",
   "unit": "C",
   "label": "Room Temperature",
   "description": "Ambient temperature reported for the space, in degrees Celsius."
  },
  {
   "name": "occupancy-count",
   "data_type": "int",
   "label": "Occupancy Count",
   "description": "People detected in the space by the room's occupancy source."
  }
 ],
 "event_types": [
  {
   "name": "call-started",
   "label": "Call Started",
   "description": "A conferencing endpoint entered an active call. A caught occurrence when the device reports it natively (an xAPI event), or a derived one when a rule infers it from other signals."
  },
  {
   "name": "command-issued",
   "label": "Command Issued",
   "description": "A command was issued to a component (the caused event a command records). It opens the intended value the command sets and is the lineage cause of that intended value."
  },
  {
   "name": "call-ended",
   "label": "Call Ended",
   "description": "A conferencing endpoint left an active call: call-started's closing half, caught natively or derived. The pair brackets a session for usage reads."
  },
  {
   "name": "input-changed",
   "label": "Input Changed",
   "description": "A display or switcher moved to a different source input. Caught natively where the device reports it; a frequent, benign occurrence that teaches the event lane's volume without implying a fault."
  }
 ],
 "command_types": [
  {
   "name": "set-input",
   "label": "Set Input",
   "description": "Tell a display or switcher which video input to select. A settleable command: it opens an intended video-input and settles when the device reports that input within the settle window."
  },
  {
   "name": "reboot",
   "label": "Reboot",
   "description": "Tell a component to restart. A fire-and-forget command: it records the invocation and a caused event, with no intended value to settle."
  }
 ],
