[
  {
    "class": "node-probe",
    "reserved": true,
    "doc": "what a node's own probes and session machine write: the node's account of an endpoint",
    "keys": [
      "collection-failed",
      "endpoint-authenticated",
      "endpoint-reachable",
      "endpoint-rejection",
      "endpoint-responsive",
      "http-response-time",
      "icmp-reachable",
      "icmp-rtt-avg",
      "session-reason",
      "session-state",
      "ssh-handshake-time",
      "ssh-host-key",
      "tcp-connect-time",
      "tcp-open",
      "telnet-response-time"
    ],
    "admits": [
      {
        "writer": "node",
        "doc": "the node lane, under the endpoint whose task the node ran"
      }
    ],
    "pins": [
      {
        "key": "ssh-host-key",
        "writer": "host-key-pin",
        "doc": "an operator's pin, set with an endpoint's :retry (ADR-0157)"
      }
    ]
  },
  {
    "class": "platform",
    "reserved": true,
    "doc": "what only the Omniglass process writes about itself or its rollups",
    "keys": [
      "health"
    ],
    "admits": [
      {
        "writer": "process",
        "doc": "the Omniglass process (the health rollup)"
      }
    ]
  },
  {
    "class": "command-lifecycle",
    "reserved": true,
    "doc": "the events a command's own lifecycle writes on its owner's timeline",
    "keys": [
      "command-issued"
    ],
    "admits": [
      {
        "writer": "command",
        "doc": "a command's intended value and caused event"
      }
    ]
  },
  {
    "class": "calc",
    "reserved": false,
    "doc": "a key a calc rule names as its output",
    "admits": [
      {
        "writer": "calc-rule",
        "doc": "the calc rule's tick"
      },
      {
        "writer": "operator",
        "doc": "an operator's declared value"
      }
    ]
  },
  {
    "class": "collected",
    "reserved": false,
    "doc": "every other key: what a driver's emits, a push, a command or an operator say",
    "admits": [
      {
        "writer": "node",
        "doc": "the node lane, under the endpoint whose task the node ran"
      },
      {
        "writer": "push",
        "doc": "the telemetry push lane"
      },
      {
        "writer": "command",
        "doc": "a command's intended value and caused event"
      },
      {
        "writer": "command-reply",
        "doc": "a command's reply, read through its driver binding"
      },
      {
        "writer": "operator",
        "doc": "an operator's declared value"
      },
      {
        "writer": "event-rule",
        "doc": "an event rule's fire or clear event"
      }
    ]
  }
]
